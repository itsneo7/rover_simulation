<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================
       RPLIDAR S3  (2D LiDAR, gz sim gpu_lidar sensor)
       ================================================================ -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
      <material name="ares_sensor_blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="rplidar_s3" type="gpu_lidar">
      <frame_id>lidar_link</frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>${lidar_update_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_min_angle}</min_angle>
            <max_angle>${lidar_max_angle}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>${lidar_min_range}</min>
          <max>${lidar_max_range}</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>${lidar_noise_stddev}</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ================================================================
       INTEL REALSENSE D456 (functional-equivalent RGB-D via gz rgbd_camera)
       NOTE: Gazebo simulates the functional equivalent of the D456 RGB-D
       output. This is NOT the vendor Realsense driver / hardware emulation.
       ================================================================ -->
  <link name="realsense_D456_link">
    <visual>
      <geometry><box size="0.03 0.09 0.025"/></geometry>
      <material name="ares_sensor_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.03 0.09 0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.075"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="realsense_D456_joint" type="fixed">
    <parent link="base_link"/>
    <child link="realsense_D456_link"/>
    <origin xyz="${d456_x} ${d456_y} ${d456_z}" rpy="0 ${d456_pitch} 0"/>
  </joint>

  <!-- Optical frame: REP-103 camera convention (z forward, x right, y down) -->
  <link name="realsense_D456_optical_frame"/>
  <joint name="realsense_D456_optical_joint" type="fixed">
    <parent link="realsense_D456_link"/>
    <child link="realsense_D456_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>

  <gazebo reference="realsense_D456_link">
    <sensor name="realsense_D456" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>realsense_D456</topic>
      <update_rate>${d456_update_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>${d456_h_fov}</horizontal_fov>
        <image>
          <width>${d456_img_width}</width>
          <height>${d456_img_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>${d456_min_depth}</near>
          <far>${d456_max_depth}</far>
        </clip>
        <optical_frame_id>realsense_D456_optical_frame</optical_frame_id>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ================================================================
       BNO085 IMU
       ================================================================ -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.008"/></geometry>
      <material name="ares_sensor_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.02 0.008"/></geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="bno085" type="imu">
      <pose>0 0 0 0 0 0</pose>
      <topic>imu</topic>
      <update_rate>${imu_update_rate}</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_gyro_noise_stddev}</stddev><bias_stddev>${imu_gyro_bias_stddev}</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_accel_noise_stddev}</stddev><bias_stddev>${imu_accel_bias_stddev}</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ================================================================
       TFmini-style forward range sensor
       Modeled as a single-ray gpu_lidar (functional equivalent of a
       single-point ToF range sensor). Publishes a 1-sample LaserScan
       which the tfmini bridge/driver node in ares1_perception converts
       to sensor_msgs/Range on /tfmini/range.
       ================================================================ -->
  <link name="tfmini_link">
    <visual>
      <geometry><box size="0.02 0.015 0.01"/></geometry>
      <material name="ares_sensor_blue"/>
    </visual>
    <collision>
      <geometry><box size="0.02 0.015 0.01"/></geometry>
    </collision>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>

  <joint name="tfmini_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tfmini_link"/>
    <origin xyz="${tfmini_x} ${tfmini_y} ${tfmini_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="tfmini_link">
    <sensor name="tfmini" type="gpu_lidar">
      <frame_id>tfmini_link</frame_id>
      <pose>0 0 0 0 0 0</pose>
      <topic>tfmini/scan_raw</topic>
      <update_rate>20</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.02</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

</robot>
