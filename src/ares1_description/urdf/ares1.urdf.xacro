<?xml version="1.0"?>
<robot name="ares1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ares1_description)/urdf/ares1_properties.xacro"/>
  <xacro:include filename="$(find ares1_description)/urdf/materials.xacro"/>

  <xacro:arg name="use_sim" default="true"/>

  <!-- ================================================================
       BASE FOOTPRINT / BASE LINK
       ================================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${chassis_ground_clearance}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="ares_chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia
        ixx="${(1/12.0)*chassis_mass*(chassis_width*chassis_width + chassis_height*chassis_height)}"
        ixy="0.0" ixz="0.0"
        iyy="${(1/12.0)*chassis_mass*(chassis_length*chassis_length + chassis_height*chassis_height)}"
        iyz="0.0"
        izz="${(1/12.0)*chassis_mass*(chassis_length*chassis_length + chassis_width*chassis_width)}"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- ================================================================
       WHEEL MODULE MACRO
       Chain: base_link -> steering_joint(continuous,Z) -> steering_link
              -> suspension_joint(prismatic,Z, spring-damped) -> suspension_link
              -> wheel_joint(continuous,Y, velocity) -> wheel_link
       ================================================================ -->
  <xacro:macro name="wheel_module" params="prefix x_pos y_pos">

    <!-- STEERING LINK (vertical swivel axis) -->
    <link name="${prefix}_steering_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${steering_link_radius}" length="${steering_link_length}"/>
        </geometry>
        <material name="ares_steering_orange"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${steering_link_radius}" length="${steering_link_length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${steering_mass}"/>
        <inertia
          ixx="${(1/12.0)*steering_mass*(3*steering_link_radius*steering_link_radius + steering_link_length*steering_link_length)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1/12.0)*steering_mass*(3*steering_link_radius*steering_link_radius + steering_link_length*steering_link_length)}"
          iyz="0.0"
          izz="${0.5*steering_mass*steering_link_radius*steering_link_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_steering_link"/>
      <origin xyz="${x_pos} ${y_pos} ${-chassis_height/2.0 - steering_link_length/2.0}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit_rad}" upper="${steering_limit_rad}"
             effort="${steering_effort}" velocity="${steering_velocity}"/>
      <dynamics damping="0.4" friction="0.15"/>
    </joint>

    <!-- SUSPENSION LINK (prismatic, vertical travel, spring-damped) -->
    <link name="${prefix}_suspension_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${suspension_link_radius}" length="${suspension_link_length}"/>
        </geometry>
        <material name="ares_suspension_dark"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${suspension_link_radius}" length="${suspension_link_length}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${suspension_mass}"/>
        <inertia
          ixx="${(1/12.0)*suspension_mass*(3*suspension_link_radius*suspension_link_radius + suspension_link_length*suspension_link_length)}"
          ixy="0.0" ixz="0.0"
          iyy="${(1/12.0)*suspension_mass*(3*suspension_link_radius*suspension_link_radius + suspension_link_length*suspension_link_length)}"
          iyz="0.0"
          izz="${0.5*suspension_mass*suspension_link_radius*suspension_link_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_suspension_joint" type="prismatic">
      <parent link="${prefix}_steering_link"/>
      <child link="${prefix}_suspension_link"/>
      <origin xyz="0 0 ${-steering_link_length/2.0 - suspension_link_length/2.0}" rpy="0 0 0"/>
      <!-- Steering axis stays vertical: suspension travels along the SAME Z axis
           as the steering link, purely translating below it, so it never rotates
           the steering axis. -->
      <axis xyz="0 0 1"/>
      <limit lower="${-suspension_travel}" upper="${suspension_travel}"
             effort="${suspension_effort}" velocity="2.0"/>
      <dynamics damping="${suspension_damping/1000.0}" friction="0.05"/>
    </joint>

    <!-- Raw SDF passthrough: URDF <dynamics> has no spring_stiffness field,
         so the physical spring constant is injected here via <gazebo reference="">,
         which sdformat merges directly into the generated SDF <joint><axis><dynamics>. -->
    <gazebo reference="${prefix}_suspension_joint">
      <axis>
        <dynamics>
          <damping>${suspension_damping}</damping>
          <friction>5.0</friction>
          <spring_stiffness>${suspension_stiffness}</spring_stiffness>
          <spring_reference>0.0</spring_reference>
        </dynamics>
      </axis>
    </gazebo>

    <!-- WHEEL LINK -->
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="ares_wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${(1/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0.0" ixz="0.0"
          iyy="${0.5*wheel_mass*wheel_radius*wheel_radius}"
          iyz="0.0"
          izz="${(1/12.0)*wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_suspension_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 0 ${-suspension_link_length/2.0 - wheel_radius + suspension_travel}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.05"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Black</material>
      <mu1>0.9</mu1>
      <mu2>0.9</mu2>
    </gazebo>

  </xacro:macro>

  <!-- Instantiate the four wheel modules using the geometry given in the spec:
       FL = (+wheelbase/2, +track_width/2)
       FR = (+wheelbase/2, -track_width/2)
       RL = (-wheelbase/2, +track_width/2)
       RR = (-wheelbase/2, -track_width/2) -->
  <xacro:wheel_module prefix="front_left"  x_pos="${wheelbase/2.0}"  y_pos="${track_width/2.0}"/>
  <xacro:wheel_module prefix="front_right" x_pos="${wheelbase/2.0}"  y_pos="${-track_width/2.0}"/>
  <xacro:wheel_module prefix="rear_left"   x_pos="${-wheelbase/2.0}" y_pos="${track_width/2.0}"/>
  <xacro:wheel_module prefix="rear_right"  x_pos="${-wheelbase/2.0}" y_pos="${-track_width/2.0}"/>

  <!-- ================================================================
       SENSORS
       ================================================================ -->
  <xacro:include filename="$(find ares1_description)/urdf/sensors.xacro"/>

  <!-- ================================================================
       ROS 2 CONTROL
       ================================================================ -->
  <xacro:include filename="$(find ares1_description)/urdf/ares1.ros2_control.xacro"/>

  <!-- ================================================================
       GAZEBO ROS2 CONTROL PLUGIN (Gazebo Harmonic / gz_ros2_control)
       ================================================================ -->
  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find ares1_control)/config/ros2_controllers.yaml</parameters>
        <robot_param>robot_description</robot_param>
        <robot_param_node>robot_state_publisher</robot_param_node>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
